{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=MeetSyncDB;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "MeetSyncSettings": {
    "MaxParticipantsPerRoom": 50,
    "EnableScreenSharing": true,
    "StunServerUrl": "stun:stun.l.google.com:19302",
    "SessionTimeoutMinutes": 60,
    "UseRedisStateStore": false,
    "RedisConnectionString": "localhost:6379"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
