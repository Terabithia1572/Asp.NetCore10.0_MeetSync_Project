@{
    Layout = "_MeetSyncLayout";
    ViewData["Title"] = "Toplantı: " + ViewBag.RoomName;
}

<style>
    /* ── TOOLBAR ── */
    .toolbar-wrap {
        position: fixed;
        bottom: 28px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 50;
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 8px 10px;
        background: rgba(9, 9, 11, 0.85);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        box-shadow: 0 24px 48px -8px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.03) inset;
        white-space: nowrap;
    }

    .tb-divider {
        width: 1px;
        height: 32px;
        background: rgba(255,255,255,0.07);
        margin: 0 2px;
        flex-shrink: 0;
    }

    /* Icon-only butonlar */
    .tb-icon {
        width: 52px;
        height: 52px;
        border-radius: 16px;
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.07);
        color: #cbd5e1;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.18s cubic-bezier(0.34,1.56,0.64,1);
        flex-shrink: 0;
    }

    .tb-icon:hover { background: rgba(255,255,255,0.1); color: #fff; transform: translateY(-2px); }
    .tb-icon:active { transform: scale(0.92); }

    .tb-icon .material-symbols-outlined {
        font-size: 22px;
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .tb-icon.is-on {
        background: #0d59f2;
        border-color: transparent;
        color: #fff;
        box-shadow: 0 8px 20px -4px rgba(13,89,242,0.45);
    }

    .tb-icon.is-off {
        background: rgba(239,68,68,0.12);
        border-color: rgba(239,68,68,0.2);
        color: #f87171;
    }

    /* Chat butonu */
    .tb-chat {
        height: 52px;
        padding: 0 18px;
        border-radius: 16px;
        background: rgba(13,89,242,0.12);
        border: 1px solid rgba(13,89,242,0.2);
        color: #60a5fa;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 700;
        font-size: 12px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        transition: all 0.18s cubic-bezier(0.34,1.56,0.64,1);
        flex-shrink: 0;
        position: relative;
    }

    .tb-chat:hover { background: rgba(13,89,242,0.2); color: #93c5fd; transform: translateY(-2px); }

    .tb-chat .material-symbols-outlined {
        font-size: 20px;
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }

    .tb-chat .chat-badge {
        display: none;
        position: absolute;
        top: 10px; right: 10px;
        width: 8px; height: 8px;
        background: #0d59f2;
        border-radius: 50%;
        border: 2px solid #09090b;
        animation: badgePulse 1.5s infinite;
    }

    .tb-chat.has-unread .chat-badge { display: block; }

    @@keyframes badgePulse {
        0%,100% { transform: scale(1); }
        50%      { transform: scale(1.3); }
    }

    /* Toplantıyı Bitir */
    .tb-end {
        height: 52px;
        padding: 0 20px;
        border-radius: 16px;
        background: linear-gradient(135deg, #dc2626 0%, #b91c1c 100%);
        border: 1px solid rgba(255,255,255,0.08);
        color: #fff;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 800;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: all 0.18s cubic-bezier(0.34,1.56,0.64,1);
        box-shadow: 0 8px 24px -4px rgba(220,38,38,0.4);
        flex-shrink: 0;
    }

    .tb-end:hover { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); box-shadow: 0 12px 28px -4px rgba(220,38,38,0.55); transform: translateY(-2px); }
    .tb-end:active { transform: scale(0.94); }
    .tb-end .material-symbols-outlined { font-size: 18px; font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }

    /* Ayrıl */
    .tb-leave {
        height: 52px;
        padding: 0 20px;
        border-radius: 16px;
        background: rgba(239,68,68,0.1);
        border: 1px solid rgba(239,68,68,0.18);
        color: #f87171;
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-weight: 800;
        font-size: 11px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        transition: all 0.18s cubic-bezier(0.34,1.56,0.64,1);
        flex-shrink: 0;
    }

    .tb-leave:hover { background: rgba(239,68,68,0.18); border-color: rgba(239,68,68,0.3); color: #fca5a5; transform: translateY(-2px); }
    .tb-leave:active { transform: scale(0.94); }
    .tb-leave .material-symbols-outlined { font-size: 18px; font-variation-settings: 'FILL' 1, 'wght' 500, 'GRAD' 0, 'opsz' 24; }
    .toolbar-wrap { flex-wrap: wrap; justify-content: center; width: max-content; max-width: calc(100vw - 24px); }
    .tb-icon.hidden, .tb-chat.hidden, .tb-end.hidden { display: none; }
    .tb-icon:disabled, .tb-chat:disabled { opacity: .5; cursor: wait; }
    .meeting-role { font-size: 10px; color: #94a3b8; font-weight: 600; }
    .tb-icon:disabled, .tb-chat:disabled, .tb-end:disabled { opacity: .45; cursor: not-allowed; transform: none; box-shadow: none; }
    #btn-lock-room { position: relative; }
    #btn-lock-room.room-open { color: #94a3b8; }
    #btn-lock-room.room-locked { color: #fbbf24; background: rgba(245,158,11,.12); border-color: rgba(245,158,11,.28); }
    #btn-lock-room.room-locked::after { content: ''; position: absolute; top: 9px; right: 9px; width: 5px; height: 5px; border-radius: 50%; background: #fbbf24; box-shadow: 0 0 8px #f59e0b66; }
    #room-lock-status.room-locked { color: #fcd34d; background: #78350f; }
    #room-lock-status { font-size: 11px; padding: 4px 8px; border-radius: 8px; color: #6ee7b7; background: #064e3b; }
    .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
    .quality-trigger { width: auto; min-width: 108px; padding: 0 12px; gap: 8px; }
    .quality-trigger .quality-value { font-size: 12px; font-weight: 700; letter-spacing: .02em; color: #e2e8f0; }
    .quality-trigger .quality-chevron { font-size: 16px; color: #64748b; transition: transform .18s; }
    .quality-trigger[aria-expanded="true"] { background: rgba(13,89,242,.14); border-color: rgba(59,130,246,.4); color: #60a5fa; }
    .quality-trigger[aria-expanded="true"] .quality-chevron { transform: rotate(180deg); }
    .quality-menu { position: fixed; z-index: 1000; width: 264px; max-width: calc(100vw - 24px); max-height: calc(100vh - 24px); overflow-y: auto; padding: 8px; background: rgba(17,19,25,.98); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,.1); border-radius: 20px; box-shadow: 0 20px 64px #0009, inset 0 1px 0 #ffffff06; color: #e2e8f0; }
    .quality-menu[hidden] { display: none; }
    .quality-menu-heading { padding: 10px 10px 12px; font-size: 10px; letter-spacing: .14em; font-weight: 800; color: #94a3b8; }
    .quality-option { width: 100%; display: flex; align-items: center; gap: 12px; text-align: left; padding: 10px; border: 1px solid transparent; border-radius: 12px; background: transparent; color: #cbd5e1; cursor: pointer; transition: background .15s; }
    .quality-option:hover { background: #ffffff08; }
    .quality-option[aria-checked="true"] { background: #2563eb18; border-color: #3b82f633; color: #60a5fa; }
    .quality-option strong { display: block; font-size: 13px; font-weight: 700; }
    .quality-option small { display: block; margin-top: 2px; font-size: 10px; color: #64748b; }
    .quality-option .quality-check { margin-left: auto; font-size: 18px; opacity: 0; }
    .quality-option[aria-checked="true"] .quality-check { opacity: 1; }
    .quality-option .quality-tier { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 9px; background: #ffffff05; font-size: 10px; font-weight: 800; color: #94a3b8; }
    .quality-option[aria-checked="true"] .quality-tier { background: #3b82f61a; color: #60a5fa; }
    .quality-menu-footer { margin: 6px 8px 2px; padding-top: 10px; border-top: 1px solid #ffffff08; font-size: 10px; line-height: 1.5; color: #64748b; }
    .quality-option:focus-visible, .quality-trigger:focus-visible, #btn-lock-room:focus-visible { outline: 2px solid #60a5fa; outline-offset: 3px; }
    .meeting-feedback { position: absolute; top: 10px; left: 16px; right: 16px; z-index: 15; font-size: 12px; color: #94a3b8; display: flex; flex-wrap: wrap; gap: 10px; }
    #media-status.media-error { color: #fca5a5; }
    #recording-download { color: #6ee7b7; text-decoration: underline; }
</style>

<header class="flex items-center justify-between px-6 py-3 border-b border-white/5 bg-background-dark/50 backdrop-blur-sm z-20">
    <div class="flex items-center gap-4">
        <div class="size-8 bg-primary rounded-lg flex items-center justify-center">
            <span class="material-symbols-outlined text-white text-xl">hub</span>
        </div>
        <div>
            <h1 class="text-white text-sm font-bold leading-tight tracking-tight uppercase opacity-60">MeetSync Pro</h1>
            <h2 class="text-white text-base font-semibold leading-tight flex items-center gap-3">
                Oda: @ViewBag.RoomName
                <span id="meeting-role" class="meeting-role" role="status">Rol bekleniyor</span>
                <span id="room-lock-status" role="status">Oda açık</span>
                <div id="rec-badge" class="hidden flex items-center gap-2 px-3 py-1 bg-red-600/20 border border-red-500/30 rounded-full animate-pulse">
                    <span class="size-2 rounded-full bg-red-500"></span>
                    <span class="text-xs font-black text-red-500 tracking-wider">REC</span>
                </div>
            </h2>
        </div>
    </div>

    <div class="flex items-center gap-3">
        <button id="toggleParticipants" class="px-4 py-2 rounded-full bg-white/5 border border-white/10 flex items-center gap-2 hover:bg-white/10 transition-all cursor-pointer">
            <span class="material-symbols-outlined text-xs text-primary">groups</span>
            <span id="participant-count" class="text-xs font-bold text-white">1 Katılımcı</span>
        </button>
    </div>
</header>

<main class="flex h-[calc(100vh-64px)] overflow-hidden bg-[#050505] relative font-display">
    <div class="meeting-feedback">
        <span id="media-status" role="status" aria-live="polite"></span>
        <span id="share-status" role="status">Paylaşım kapalı</span>
        <a id="recording-download" class="hidden" href="#">Kaydı indir</a>
    </div>

    <div class="flex-1 relative flex items-center justify-center p-12 overflow-hidden">
        <div id="video-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 w-full max-w-[1500px] auto-rows-max items-center">

            <div id="local-container" class="relative group rounded-[2.5rem] overflow-hidden bg-zinc-900 aspect-video shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/5 transition-all hover:border-primary/40">
                <video id="localVideo" autoplay muted playsinline class="w-full h-full object-cover bg-black"></video>
                <div class="absolute bottom-6 left-6 px-4 py-2 rounded-2xl bg-black/40 backdrop-blur-xl border border-white/10">
                    <span id="local-name-label" class="text-[10px] font-black tracking-[0.2em] text-white uppercase cursor-pointer hover:text-primary transition-colors" onclick="changeMyName()">
                        @ViewBag.UserName (SİZ)
                    </span>
                </div>
            </div>

        </div>

        <!-- Live Captions Banner Overlay -->
        <div id="live-caption-overlay" class="hidden absolute bottom-24 left-1/2 -translate-x-1/2 z-40 max-w-2xl px-6 py-3 bg-black/80 backdrop-blur-xl border border-white/10 rounded-2xl text-center shadow-2xl transition-all">
            <span id="caption-speaker" class="text-xs font-black text-primary uppercase mr-2"></span>
            <span id="caption-text" class="text-sm font-medium text-white"></span>
        </div>

        <!-- TOOLBAR -->
        <div class="toolbar-wrap" id="meetingToolbar">

            <!-- Mikrofon -->
            <button id="btn-mic" class="tb-icon is-on" title="Mikrofon">
                <span class="material-symbols-outlined" id="mic-icon">mic</span>
            </button>

            <!-- Kamera -->
            <button id="btn-cam" class="tb-icon is-on" title="Kamera">
                <span class="material-symbols-outlined" id="cam-icon">videocam</span>
            </button>

            <div class="tb-divider"></div>

            <!-- Ekran Paylaşımı -->
            <select id="share-quality" hidden aria-label="Ekran paylaşım kalitesi">
                <option value="480" >480p</option>
                <option value="720" >720p</option>
                <option value="1080" selected>1080p</option>
                <option value="1440" >2K</option>
                <option value="2160" >4K</option>
            </select>
            <button id="quality-trigger" type="button" class="tb-icon quality-trigger" aria-haspopup="dialog" aria-expanded="false" aria-controls="quality-menu" title="Ekran paylaşım kalitesi">
                <span class="material-symbols-outlined" aria-hidden="true">tune</span>
                <span id="quality-value" class="quality-value">1080p</span>
                <span class="material-symbols-outlined quality-chevron" aria-hidden="true">expand_less</span>
            </button>
            <div id="quality-menu" class="quality-menu" role="dialog" aria-label="Ekran paylaşım kalitesi" hidden>
                <div class="quality-menu-heading">EKRAN KALİTESİ</div>
                <div role="radiogroup" aria-label="Çözünürlük">
                    <button type="button" class="quality-option" role="radio" data-quality="480" aria-checked="false" tabindex="-1">
                        <span class="quality-tier" aria-hidden="true">SD</span>
                        <span><strong>480p</strong><small>854 × 480 · Veri tasarrufu</small></span>
                        <span class="material-symbols-outlined quality-check" aria-hidden="true">check_circle</span>
                    </button>
                    <button type="button" class="quality-option" role="radio" data-quality="720" aria-checked="false" tabindex="-1">
                        <span class="quality-tier" aria-hidden="true">HD</span>
                        <span><strong>720p</strong><small>1280 × 720 · Dengeli</small></span>
                        <span class="material-symbols-outlined quality-check" aria-hidden="true">check_circle</span>
                    </button>
                    <button type="button" class="quality-option" role="radio" data-quality="1080" aria-checked="true" tabindex="0">
                        <span class="quality-tier" aria-hidden="true">FHD</span>
                        <span><strong>1080p</strong><small>1920 × 1080 · Önerilen</small></span>
                        <span class="material-symbols-outlined quality-check" aria-hidden="true">check_circle</span>
                    </button>
                    <button type="button" class="quality-option" role="radio" data-quality="1440" aria-checked="false" tabindex="-1">
                        <span class="quality-tier" aria-hidden="true">2K</span>
                        <span><strong>2K</strong><small>2560 × 1440 · Daha fazla detay</small></span>
                        <span class="material-symbols-outlined quality-check" aria-hidden="true">check_circle</span>
                    </button>
                    <button type="button" class="quality-option" role="radio" data-quality="2160" aria-checked="false" tabindex="-1">
                        <span class="quality-tier" aria-hidden="true">4K</span>
                        <span><strong>4K</strong><small>3840 × 2160 · En yüksek detay</small></span>
                        <span class="material-symbols-outlined quality-check" aria-hidden="true">check_circle</span>
                    </button>
                </div>
                <div class="quality-menu-footer">Paylaşım sırasında değiştirebilirsin.<br>Gerçek kalite bağlantına ve ekranına bağlıdır.</div>
            </div>
            <button id="btn-share" class="tb-icon" title="Ekran Paylaş">
                <span class="material-symbols-outlined" id="share-icon">present_to_all</span>
            </button>

            <!-- Closed Captions / Canlı Altyazı -->
            <button id="btn-cc" class="tb-icon" onclick="toggleClosedCaptions()" title="Canlı Altyazı (CC)">
                <span class="material-symbols-outlined" id="cc-icon">subtitles</span>
            </button>

            <!-- AI Özet Oluştur (Moderatör için) -->
            <button id="btn-ai-summary" class="tb-icon" disabled onclick="generateAiSummary()" title="Yapay Zeka Özeti Üret">
                <span class="material-symbols-outlined text-purple-400">auto_awesome</span>
            </button>

            <!-- Kaydı Başlat/Durdur (Moderatör için) -->
            <button id="btn-rec" class="tb-icon" disabled onclick="toggleRecording()" title="Kaydı Başlat/Durdur">
                <span class="material-symbols-outlined text-red-500" id="rec-icon">fiber_manual_record</span>
            </button>

            <!-- Odayı Kilitle (Moderatör için) -->
            <button id="btn-lock-room" class="tb-icon room-open" disabled aria-label="Oda açık — odayı kilitle" onclick="toggleRoomLock()" title="Oda açık — odayı kilitle" aria-pressed="false">
                <span id="lock-icon" class="material-symbols-outlined">lock_open</span>
                <span id="lock-label" class="visually-hidden">Açık · Kilitle</span>
            </button>

            <!-- Sohbet -->
            <button onclick="toggleSidebar('chat')" class="tb-chat" title="Sohbet">
                <span class="material-symbols-outlined">chat_bubble</span>
                <span>Sohbet</span>
                <span class="chat-badge" id="chatBadge"></span>
            </button>

            <div class="tb-divider"></div>

            <!-- Toplantıyı Bitir (Moderatör için) -->
            <button id="btn-end-meeting" class="tb-end" disabled onclick="endMeetingConfirm()">
                <span class="material-symbols-outlined">cancel</span>
                <span>Bitir</span>
            </button>

            <!-- Ayrıl -->
            <button onclick="leaveMeeting()" class="tb-leave">
                <span class="material-symbols-outlined">call_end</span>
                <span>Ayrıl</span>
            </button>

        </div>
    </div>

    <!-- Katılımcılar Paneli -->
    <aside id="participants-panel" class="hidden w-[400px] bg-[#0c0c0e] border-l border-white/5 flex flex-col shrink-0">
        <div class="p-8 border-b border-white/5 flex items-center justify-between">
            <div>
                <h3 class="font-black text-sm tracking-[0.2em] text-white/60">KATILIMCILAR</h3>
                <p class="text-xs text-slate-500 mt-1" id="participantsPanelCount">Odadaki kişi sayısı: 1</p>
            </div>
            <button id="closeParticipants" class="text-white/40 hover:text-white transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>
        <div id="participant-list" class="flex-1 overflow-y-auto p-6">
            <ul id="participants-ul" class="space-y-3"></ul>
        </div>
    </aside>

    <!-- Sohbet Paneli -->
    <aside id="sidebar" class="w-[400px] bg-[#0c0c0e] border-l border-white/5 flex flex-col shrink-0">
        <div class="p-8 border-b border-white/5 flex items-center justify-between">
            <h3 class="font-black text-sm tracking-[0.2em] text-white/60">SOHBET</h3>
            <span class="material-symbols-outlined text-white/20">more_horiz</span>
        </div>
        <div id="chat-messages" class="flex-1 overflow-y-auto p-8 space-y-6"></div>
        <div class="p-8 border-t border-white/5 bg-zinc-950/50">
            <div class="relative">
                <input id="chat-input" class="w-full bg-zinc-900 border border-white/10 rounded-2xl px-6 py-4 text-sm text-white outline-none focus:border-primary/50 transition-all" placeholder="Mesaj gönder..." />
                <button id="btn-send-chat" class="absolute right-3 top-1/2 -translate-y-1/2 size-10 rounded-xl bg-primary flex items-center justify-center shadow-lg">
                    <span class="material-symbols-outlined text-sm">send</span>
                </button>
            </div>
        </div>
    </aside>
</main>

<!-- Moderatör Modal -->
<div id="moderatorModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-sm z-[100] flex items-center justify-center p-6">
    <div class="bg-zinc-900 border border-white/10 rounded-3xl p-10 max-w-md w-full shadow-2xl">
        <div class="text-center mb-8">
            <div class="size-16 bg-red-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4">
                <span class="material-symbols-outlined text-red-500 text-4xl">warning</span>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">Moderatör Sizsiniz</h3>
            <p class="text-slate-400 text-sm">Ayrılmadan önce yeni bir moderatör seçin veya toplantıyı herkes için sonlandırın.</p>
        </div>
        <div class="space-y-3 mb-6" id="moderatorCandidates"></div>
        <div class="flex gap-3">
            <button onclick="cancelLeave()" class="flex-1 h-12 rounded-2xl bg-white/5 hover:bg-white/10 text-white font-bold transition-all">Vazgeç</button>
            <button onclick="endMeetingForAll()" class="flex-1 h-12 rounded-2xl bg-red-600 hover:bg-red-700 text-white font-bold transition-all">Toplantıyı Bitir</button>
        </div>
    </div>
</div>

<!-- AI Summary Modal -->
<div id="aiSummaryModal" class="hidden fixed inset-0 bg-black/80 backdrop-blur-md z-[150] flex items-center justify-center p-6">
    <div class="bg-zinc-900 border border-purple-500/20 rounded-3xl p-8 max-w-2xl w-full shadow-2xl max-h-[85vh] flex flex-col">
        <div class="flex items-center justify-between pb-6 border-b border-white/10">
            <div class="flex items-center gap-3">
                <div class="size-10 bg-purple-500/20 rounded-xl flex items-center justify-center">
                    <span class="material-symbols-outlined text-purple-400">auto_awesome</span>
                </div>
                <div>
                    <h3 class="text-lg font-black text-white">Yapay Zeka Toplantı Özeti</h3>
                    <p class="text-xs text-slate-400" id="aiSummaryTimestamp">Oluşturuldu: Şimdi</p>
                </div>
            </div>
            <button onclick="closeAiSummaryModal()" class="text-slate-400 hover:text-white transition-colors">
                <span class="material-symbols-outlined">close</span>
            </button>
        </div>

        <div class="flex-1 overflow-y-auto py-6 space-y-6">
            <div>
                <h4 class="text-xs font-black tracking-wider text-purple-400 uppercase mb-2">Genel Özet</h4>
                <p id="aiSummaryText" class="text-sm text-slate-300 bg-white/5 p-4 rounded-2xl border border-white/5 leading-relaxed"></p>
            </div>

            <div>
                <h4 class="text-xs font-black tracking-wider text-green-400 uppercase mb-2">Alınan Kararlar</h4>
                <ul id="aiKeyDecisions" class="space-y-2 text-sm text-slate-300"></ul>
            </div>

            <div>
                <h4 class="text-xs font-black tracking-wider text-blue-400 uppercase mb-2">Aksiyon Maddeleri</h4>
                <ul id="aiActionItems" class="space-y-2 text-sm text-slate-300"></ul>
            </div>
        </div>

        <div class="pt-4 border-t border-white/10 flex justify-end">
            <button onclick="closeAiSummaryModal()" class="px-6 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition-all">Tamam</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/microsoft/signalr/dist/browser/signalr.js"></script>
    <script>
        window.currentRoomId = "@ViewBag.RoomId";
        window.currentRoomName = @Json.Serialize((string)ViewBag.RoomName);
        const roomName = window.currentRoomName;
        let userName = @Json.Serialize((string)ViewBag.UserName);

        document.getElementById('toggleParticipants').addEventListener('click', () => {
            const panel = document.getElementById('participants-panel');
            const chat  = document.getElementById('sidebar');
            if (panel.classList.contains('hidden')) {
                panel.classList.remove('hidden');
                chat.classList.add('hidden');
            } else {
                panel.classList.add('hidden');
                chat.classList.remove('hidden');
            }
        });

        document.getElementById('closeParticipants').addEventListener('click', () => {
            document.getElementById('participants-panel').classList.add('hidden');
            document.getElementById('sidebar').classList.remove('hidden');
        });

        function toggleSidebar(type) {
            if (type === 'chat') {
                document.getElementById('participants-panel').classList.add('hidden');
                document.getElementById('sidebar').classList.remove('hidden');
            }
        }







        function showChatBadge() {
            document.querySelector('.tb-chat')?.classList.add('has-unread');
        }
    </script>
    <script src="~/js/quality-picker.js" asp-append-version="true"></script>
    <script src="~/js/meeting-media.js" asp-append-version="true"></script>
    <script src="~/js/webrtc.js" asp-append-version="true"></script>
}
